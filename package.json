{
  "name": "taskymed-essential-qa",
  "private": true,
  "version": "0.1.0",
  "description": "Independent Playwright and TypeScript QA framework for TaskyMed Essential-plan verification.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "install:browsers": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "lint": "eslint framework tests eslint.config.js playwright.config.ts",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "qa:check": "npm run typecheck && npm run lint && npm run format:check && npm run catalog:validate && npm run test:unit",
    "verify:config": "node --import tsx/esm framework/scripts/verify.ts environment",
    "verify:env": "npm run verify:config",
    "verify:catalog": "node --import tsx/esm framework/scripts/verify.ts catalog",
    "test:unit": "node --import tsx/esm --test framework/scripts/framework.test.ts",
    "test:environment": "node --import tsx/esm --test --test-name-pattern environment framework/scripts/framework.test.ts",
    "suite:audit": "node --import tsx/esm framework/scripts/suites.ts audit",
    "test:workflow": "node --import tsx/esm framework/scripts/suites.ts select workflow",
    "test:workspace": "node --import tsx/esm framework/scripts/suites.ts select workspace",
    "test:scenario": "node --import tsx/esm framework/scripts/suites.ts select scenario",
    "test:case": "node --import tsx/esm framework/scripts/suites.ts select case",
    "catalog:validate": "npm run verify:catalog",
    "test:smoke": "playwright test --grep @smoke --project=chromium",
    "test:sanity": "playwright test --grep @sanity",
    "test:functional": "playwright test --grep @functional",
    "test:api": "playwright test --grep @api",
    "test:integration": "playwright test --grep @integration",
    "test:licensing": "playwright test --grep @licensing",
    "test:security": "playwright test --grep @security",
    "test:regression": "playwright test --grep @regression",
    "test:e2e": "playwright test --grep @e2e",
    "test:mobile": "playwright test --grep @mobile --project=mobile-chrome --project=mobile-safari",
    "test:cross-browser": "playwright test --grep @cross-browser --project=chromium --project=firefox --project=webkit",
    "test:visual": "playwright test --grep @visual",
    "test:accessibility": "playwright test --grep @accessibility",
    "test:performance": "playwright test --grep @performance",
    "test:reliability": "playwright test --grep @reliability",
    "test:negative": "playwright test --grep @negative",
    "test:rbac": "playwright test --grep @rbac",
    "test:response-time": "playwright test --grep @response-time",
    "test:responsive": "playwright test --grep @responsive --project=mobile-chrome --project=mobile-safari",
    "test:uat": "playwright test --grep @uat",
    "test:all": "playwright test",
    "test:discover": "playwright test --list",
    "test:list": "playwright test --list",
    "test:framework": "playwright test tests/framework.spec.ts",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:last-failed": "playwright test --last-failed",
    "test:report": "node --import tsx/esm framework/scripts/reports.ts report",
    "trace": "playwright show-trace",
    "cleanup:dry-run": "node --import tsx/esm framework/scripts/reports.ts cleanup --dry-run",
    "summary": "node --import tsx/esm framework/scripts/reports.ts summary",
    "docker:smoke": "docker compose run --rm qa npm run test:smoke",
    "docker:api": "docker compose run --rm qa npm run test:api",
    "docker:regression": "docker compose run --rm qa npm run test:regression"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.61.1",
    "@types/node": "22.16.1",
    "@typescript-eslint/eslint-plugin": "8.46.2",
    "@typescript-eslint/parser": "8.46.2",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.8.3",
    "yaml": "2.8.1",
    "zod": "4.1.12"
  }
}
