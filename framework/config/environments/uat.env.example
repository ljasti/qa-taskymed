# File: framework/config/environments/uat.env.example
# Purpose: Safe UAT template; business-approved endpoint and identity values are required.
# Maintainer: Lakshmikiran J. | Project: TaskyMed QA-Practice
# Origin: Manually maintained template; copy to ignored uat.env and edit approved values.
# Usage: cp framework/config/environments/uat.env.example framework/config/environments/uat.env
# Editability: Edit only with UAT approval and synthetic/approved data policy.
QA_ENV=uat
QA_UI_BASE_URL=<approved-uat-ui-url>
QA_API_BASE_URL=<approved-uat-api-url>
QA_TENANT_ID=<approved-uat-tenant-id>
QA_FACILITY_ID=<approved-uat-facility-id>
QA_EXPECTED_APP_ID=taskymed-health-os
QA_EXPECTED_ENVIRONMENT=uat
QA_CREDENTIAL_SCOPE=uat
QA_DATASET_ID=uat-essential-synthetic
QA_LICENSE_PROFILE=essential
QA_ALLOWED_SUITES=smoke,regression,uat
QA_CLEANUP_POLICY=dry-run
QA_REPORT_NAMESPACE=uat/run
QA_ALLOW_SYNTHETIC_DATA=false
QA_ALLOW_STATE_CHANGES=false
QA_RECEPTION_EMAIL=
QA_RECEPTION_PASSWORD=
QA_PHYSICIAN_EMAIL=
QA_PHYSICIAN_PASSWORD=
QA_NURSING_EMAIL=
QA_NURSING_PASSWORD=
QA_PHARMACY_EMAIL=
QA_PHARMACY_PASSWORD=
QA_CUSTOMER_ADMIN_EMAIL=
QA_CUSTOMER_ADMIN_PASSWORD=
