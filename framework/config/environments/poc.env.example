# File: framework/config/environments/poc.env.example
# Purpose: Safe POC template; this endpoint remains unavailable until approved.
# Maintainer: Lakshmikiran J. | Project: TaskyMed QA-Practice
# Origin: Manually maintained template; copy to ignored poc.env after approval.
# Usage: cp framework/config/environments/poc.env.example framework/config/environments/poc.env
# Editability: Edit only with an approved POC identity and policy.
QA_ENV=poc
QA_UI_BASE_URL=<approved-poc-ui-url>
QA_API_BASE_URL=<approved-poc-api-url>
QA_TENANT_ID=<approved-poc-tenant-id>
QA_FACILITY_ID=<approved-poc-facility-id>
QA_EXPECTED_APP_ID=taskymed-health-os
QA_EXPECTED_ENVIRONMENT=poc
QA_CREDENTIAL_SCOPE=poc
QA_DATASET_ID=poc-essential-synthetic
QA_LICENSE_PROFILE=essential
QA_ALLOWED_SUITES=smoke,functional
QA_CLEANUP_POLICY=dry-run
QA_REPORT_NAMESPACE=poc/run
QA_ALLOW_SYNTHETIC_DATA=false
QA_ALLOW_STATE_CHANGES=false
QA_RECEPTION_EMAIL=
QA_RECEPTION_PASSWORD=
QA_PHYSICIAN_EMAIL=
QA_PHYSICIAN_PASSWORD=
QA_NURSING_EMAIL=
QA_NURSING_PASSWORD=
QA_PHARMACY_EMAIL=
QA_PHARMACY_PASSWORD=
QA_CUSTOMER_ADMIN_EMAIL=
QA_CUSTOMER_ADMIN_PASSWORD=
