# File: framework/config/environments/qa.env.example
# Purpose: Safe QA/TEST template; approved endpoint and identity values are required.
# Maintainer: Lakshmikiran J. | Project: TaskyMed QA-Practice
# Origin: Manually maintained template; copy to ignored qa.env and edit approved values.
# Usage: cp framework/config/environments/qa.env.example framework/config/environments/qa.env
# Editability: Edit the ignored file only; do not add guessed URLs or credentials.
QA_ENV=qa
QA_UI_BASE_URL=<approved-qa-ui-url>
QA_API_BASE_URL=<approved-qa-api-url>
QA_TENANT_ID=<approved-qa-tenant-id>
QA_FACILITY_ID=<approved-qa-facility-id>
QA_EXPECTED_APP_ID=taskymed-health-os
QA_EXPECTED_ENVIRONMENT=qa
QA_CREDENTIAL_SCOPE=qa
QA_DATASET_ID=qa-essential-synthetic
QA_LICENSE_PROFILE=essential
QA_ALLOWED_SUITES=smoke,api,functional,regression,security
QA_CLEANUP_POLICY=dry-run
QA_REPORT_NAMESPACE=qa/run
QA_ALLOW_SYNTHETIC_DATA=false
QA_ALLOW_STATE_CHANGES=false
QA_RECEPTION_EMAIL=
QA_RECEPTION_PASSWORD=
QA_PHYSICIAN_EMAIL=
QA_PHYSICIAN_PASSWORD=
QA_NURSING_EMAIL=
QA_NURSING_PASSWORD=
QA_PHARMACY_EMAIL=
QA_PHARMACY_PASSWORD=
QA_CUSTOMER_ADMIN_EMAIL=
QA_CUSTOMER_ADMIN_PASSWORD=
