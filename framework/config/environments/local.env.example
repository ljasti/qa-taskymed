# File: framework/config/environments/local.env.example
# Purpose: Safe LOCAL template for TaskyMed QA-Practice.
# Maintainer: Lakshmikiran J. | Project: TaskyMed QA-Practice
# Origin: Manually maintained template; copy to local.env and edit approved values.
# Usage: cp framework/config/environments/local.env.example framework/config/environments/local.env
# Editability: Edit the ignored local.env, never commit secrets.
QA_ENV=local
QA_UI_BASE_URL=http://taskymed.local
QA_API_BASE_URL=http://taskymed.local
QA_TENANT_ID=<approved-local-tenant-id>
QA_FACILITY_ID=<approved-local-facility-id>
QA_EXPECTED_APP_ID=taskymed-health-os
QA_EXPECTED_ENVIRONMENT=local
QA_CREDENTIAL_SCOPE=local
QA_DATASET_ID=local-essential-synthetic
QA_LICENSE_PROFILE=essential
QA_ALLOWED_SUITES=smoke,api,regression
QA_CLEANUP_POLICY=dry-run
QA_REPORT_NAMESPACE=local/run
QA_ALLOW_SYNTHETIC_DATA=false
QA_ALLOW_STATE_CHANGES=false
QA_RECEPTION_EMAIL=
QA_RECEPTION_PASSWORD=
QA_PHYSICIAN_EMAIL=
QA_PHYSICIAN_PASSWORD=
QA_NURSING_EMAIL=
QA_NURSING_PASSWORD=
QA_PHARMACY_EMAIL=
QA_PHARMACY_PASSWORD=
QA_CUSTOMER_ADMIN_EMAIL=
QA_CUSTOMER_ADMIN_PASSWORD=
