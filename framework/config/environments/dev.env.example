# File: framework/config/environments/dev.env.example
# Purpose: Safe DEV template; approved endpoint and identity values are required.
# Maintainer: Lakshmikiran J. | Project: TaskyMed QA-Practice
# Origin: Manually maintained template; copy to ignored dev.env and edit approved values.
# Usage: cp framework/config/environments/dev.env.example framework/config/environments/dev.env
# Editability: Edit the ignored file only; do not add guessed URLs or credentials.
QA_ENV=dev
QA_UI_BASE_URL=<approved-dev-ui-url>
QA_API_BASE_URL=<approved-dev-api-url>
QA_TENANT_ID=<approved-dev-tenant-id>
QA_FACILITY_ID=<approved-dev-facility-id>
QA_EXPECTED_APP_ID=taskymed-health-os
QA_EXPECTED_ENVIRONMENT=dev
QA_CREDENTIAL_SCOPE=dev
QA_DATASET_ID=dev-essential-synthetic
QA_LICENSE_PROFILE=essential
QA_ALLOWED_SUITES=smoke,api,functional,regression
QA_CLEANUP_POLICY=dry-run
QA_REPORT_NAMESPACE=dev/run
QA_ALLOW_SYNTHETIC_DATA=false
QA_ALLOW_STATE_CHANGES=false
QA_RECEPTION_EMAIL=
QA_RECEPTION_PASSWORD=
QA_PHYSICIAN_EMAIL=
QA_PHYSICIAN_PASSWORD=
QA_NURSING_EMAIL=
QA_NURSING_PASSWORD=
QA_PHARMACY_EMAIL=
QA_PHARMACY_PASSWORD=
QA_CUSTOMER_ADMIN_EMAIL=
QA_CUSTOMER_ADMIN_PASSWORD=
