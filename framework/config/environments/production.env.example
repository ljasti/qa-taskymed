# File: framework/config/environments/production.env.example
# Purpose: Read-only PRODUCTION template; no write dataset or state-changing policy is allowed.
# Maintainer: Lakshmikiran J. | Project: TaskyMed QA-Practice
# Origin: Manually maintained template; copy only with explicit production monitoring approval.
# Usage: cp framework/config/environments/production.env.example framework/config/environments/production.env
# Editability: Edit only approved non-secret identifiers; production remains fail-closed.
QA_ENV=production
QA_UI_BASE_URL=<approved-production-ui-url>
QA_API_BASE_URL=<approved-production-api-url>
QA_TENANT_ID=<approved-production-tenant-id>
QA_FACILITY_ID=<approved-production-facility-id>
QA_EXPECTED_APP_ID=taskymed-health-os
QA_EXPECTED_ENVIRONMENT=production
QA_CREDENTIAL_SCOPE=production
QA_DATASET_ID=production-read-only
QA_LICENSE_PROFILE=essential
QA_ALLOWED_SUITES=smoke,api
QA_CLEANUP_POLICY=dry-run
QA_REPORT_NAMESPACE=production/read-only
QA_ALLOW_SYNTHETIC_DATA=false
QA_ALLOW_STATE_CHANGES=false
QA_RECEPTION_EMAIL=
QA_RECEPTION_PASSWORD=
QA_PHYSICIAN_EMAIL=
QA_PHYSICIAN_PASSWORD=
QA_NURSING_EMAIL=
QA_NURSING_PASSWORD=
QA_PHARMACY_EMAIL=
QA_PHARMACY_PASSWORD=
QA_CUSTOMER_ADMIN_EMAIL=
QA_CUSTOMER_ADMIN_PASSWORD=
